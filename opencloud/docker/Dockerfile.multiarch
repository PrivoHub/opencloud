####################### WEB CLIENT BUILD #######################
# PrivoHub Drive ships the web client built from our own fork (source-level IEC
# storage units in packages/web-pkg/src/helpers/filesize.ts), NOT upstream's
# prebuilt release tarball. Building it here makes `docker build` self-contained
# and reproducible — no host `make generate` step — and what ships is genuinely
# the corresponding source of PrivoHub/opencloud-web, with no minified-bundle
# patching. Keep WEB_ASSETS_REF equal to services/web/Makefile's.
FROM node:22-bookworm AS web-build
ARG WEB_ASSETS_REPO=https://github.com/PrivoHub/opencloud-web.git
ARG WEB_ASSETS_REF=privohub/v6.2.0
RUN corepack enable
WORKDIR /web
RUN git clone --depth 1 --branch "${WEB_ASSETS_REF}" "${WEB_ASSETS_REPO}" . && \
    make release
# -> /web/release/{web.tar.gz,third-party-licenses.tar.gz}

####################### SERVER BUILD #######################
FROM golang:alpine3.22 AS build
ARG TARGETOS
ARG TARGETARCH
ARG VERSION
ARG STRING
ARG EDITION="dev"

RUN apk add bash make git curl gcc musl-dev libc-dev binutils-gold inotify-tools vips-dev

WORKDIR /build
# Unpack the web bundle built above into the embed dir (services/web/web.go does
# `//go:embed all:assets`) before the Go build, so it is baked into the binary.
RUN --mount=type=bind,target=/build,rw \
    --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache \
    --mount=from=web-build,source=/web/release,target=/web-release,ro \
    rm -rf services/web/assets/core services/web/assets/apps && \
    mkdir -p services/web/assets/core services/web/assets/apps && \
    tar xf /web-release/web.tar.gz -C services/web/assets/core/ && \
    mkdir -p third-party-licenses/node/web && \
    tar xf /web-release/third-party-licenses.tar.gz -C third-party-licenses/node/web/ && \
    make -C opencloud release-linux-docker-${TARGETARCH} ENABLE_VIPS=true DIST=/dist

FROM alpine:3.22
ARG VERSION
ARG REVISION
ARG TARGETOS
ARG TARGETARCH

RUN apk add --no-cache attr bash ca-certificates curl imagemagick \
                       inotify-tools libc6-compat mailcap tree vips \
		       vips-magick patch && \
    echo 'hosts: files dns' >| /etc/nsswitch.conf

COPY opencloud/docker/privohub-entrypoint.sh /usr/local/bin/privohub-entrypoint.sh
RUN chmod 0755 /usr/local/bin/privohub-entrypoint.sh

LABEL maintainer="PrivoHub" \
  org.opencontainers.image.title="PrivoHub Drive" \
  org.opencontainers.image.vendor="PrivoHub" \
  org.opencontainers.image.authors="PrivoHub" \
  org.opencontainers.image.description="PrivoHub Drive — privacy-respecting per-tenant fork of OpenCloud" \
  org.opencontainers.image.licenses="Apache-2.0" \
  org.opencontainers.image.documentation="https://github.com/PrivoHub/opencloud" \
  org.opencontainers.image.url="https://github.com/PrivoHub/opencloud" \
  org.opencontainers.image.source="https://github.com/PrivoHub/opencloud" \
  org.opencontainers.image.version="${VERSION}" \
  org.opencontainers.image.revision="${REVISION}"

RUN addgroup -g 1000 -S opencloud-group && \
  adduser -S --ingroup opencloud-group --uid 1000 opencloud-user --home /var/lib/opencloud

RUN mkdir -p /var/lib/opencloud && \
# Pre-create the web directory to avoid permission issues
 mkdir -p /var/lib/opencloud/web/assets/apps && \
 chown -R opencloud-user:opencloud-group /var/lib/opencloud && \
 chmod -R 751 /var/lib/opencloud && \
 mkdir -p /etc/opencloud && \
 chown -R opencloud-user:opencloud-group /etc/opencloud && \
 chmod -R 751 /etc/opencloud

VOLUME [ "/var/lib/opencloud", "/etc/opencloud" ]
WORKDIR /var/lib/opencloud

USER 1000

EXPOSE 9200/tcp

ENTRYPOINT ["/usr/local/bin/privohub-entrypoint.sh"]
CMD ["server"]

COPY --from=build /dist/binaries/opencloud-linux-${TARGETARCH} /usr/bin/opencloud
